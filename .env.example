# --- Base de données (Neon) ---
# URL "pooled" (avec -pooler) pour l'application
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/lavis?sslmode=require"
# URL directe (sans -pooler) pour les migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/lavis?sslmode=require"

# --- Authentification (Auth.js) ---
# Générer avec : npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET="change-me"
# Compte administrateur créé par le seed (npm run db:seed)
ADMIN_EMAIL="gaillardleo25@gmail.com"
ADMIN_PASSWORD="un-mot-de-passe-long-et-unique"

# --- URL publique du site (liens dans les e-mails) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Stockage des images et pièces jointes (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- E-mails transactionnels (Resend) ---
# Sans clé, les e-mails sont affichés dans la console (développement).
RESEND_API_KEY=""
# Expéditeur : domaine vérifié chez Resend (ex. "Lavis Studio <atelier@lavis-studio.fr>")
EMAIL_FROM="Lavis Studio <onboarding@resend.dev>"
# Adresse qui reçoit les alertes de vente et demandes sur-mesure
ARTIST_EMAIL="gaillardleo25@gmail.com"

# --- Anti-spam Cloudflare Turnstile (formulaire sur-mesure) ---
# Laisser vide en local pour désactiver la vérification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
